{
  "name": "local-agent-orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "node src/server/main.ts",
    "build": "vite build",
    "start": "node src/server/main.ts --production",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test tests/*.test.ts",
    "test:fixtures": "node --test tests/git-fixture.test.ts",
    "smoke": "node scripts/smoke.ts",
    "smoke:workflow": "node scripts/smoke-workflow.ts",
    "demo:fake": "node scripts/seed-fake.ts",
    "demo:m2": "node scripts/demo-m2.ts",
    "test:live": "node scripts/live-pi.ts",
    "test:live:lead": "node scripts/live-lead.ts",
    "test:live:claude": "node scripts/live-claude.ts",
    "test:live:opencode": "node scripts/live-opencode.ts",
    "test:live:workers": "node scripts/live-workers.ts",
    "test:live:leads": "node scripts/live-leads.ts",
    "smoke:isolation": "node scripts/smoke-isolation.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@opencode/client": "2.0.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
